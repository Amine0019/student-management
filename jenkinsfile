pipeline {
    agent any

    environment {
        // Database configuration
        DB_CONTAINER_BASE = "mysql-student"
        DB_NAME = "studentdb"
        DB_USER = "root"
        DB_PASSWORD = "root"

        // Docker image
        DOCKER_IMAGE = "lassdc/student-management:latest"
    }

    stages {

        stage('Checkout') {
            steps {
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: 'refs/heads/ilyes-mh']],
                    userRemoteConfigs: [[
                        url: 'https://github.com/Amine0019/student-management.git',
                        credentialsId: 'github-credentials'
                    ]]
                ])
            }
        }

        stage('Start MySQL (Docker)') {
            steps {
                script {
                    // Create a unique container name per build to avoid conflicts
                    env.DB_CONTAINER = "${DB_CONTAINER_BASE}-${env.BUILD_ID}"
                }
                sh '''
                # Remove any existing container with the same name
                if [ $(docker ps -a -q -f name=$DB_CONTAINER) ]; then
                    docker rm -f $DB_CONTAINER
                fi

                # Pull latest MySQL image
                docker pull mysql:8

                # Run MySQL container
                docker run -d \
                  --name $DB_CONTAINER \
                  -e MYSQL_ROOT_PASSWORD=$DB_PASSWORD \
                  -e MYSQL_DATABASE=$DB_NAME \
                  -p 3306:3306 \
                  mysql:8
                '''
            }
        }

        stage('Wait for MySQL') {
            steps {
                sh '''
                echo "Waiting for MySQL to be ready..."

                MAX_RETRIES=20
                RETRY_COUNT=0
                until docker exec $DB_CONTAINER mysqladmin ping -h "127.0.0.1" --silent; do
                    RETRY_COUNT=$((RETRY_COUNT+1))
                    if [ $RETRY_COUNT -ge $MAX_RETRIES ]; then
                        echo "MySQL did not start in time."
                        exit 1
                    fi
                    echo "Waiting for MySQL... ($RETRY_COUNT/$MAX_RETRIES)"
                    sleep 3
                done

                echo "MySQL is ready!"
                '''
            }
        }

        stage('Build & Test') {
            steps {
                sh '''
                mvn clean test \
                  -Dspring.datasource.url=jdbc:mysql://localhost:3306/$DB_NAME \
                  -Dspring.datasource.username=$DB_USER \
                  -Dspring.datasource.password=$DB_PASSWORD
                '''
            }
        }

        stage('Build JAR') {
            steps {
                sh 'mvn clean package -DskipTests'
            }
        }

        stage('Build Docker Image') {
            steps {
                sh 'docker build -t $DOCKER_IMAGE .'
            }
        }

        stage('Push Docker Image') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-credentials',
                    usernameVariable: 'DOCKER_USER',
                    passwordVariable: 'DOCKER_PSW'
                )]) {
                    sh '''
                    echo $DOCKER_PSW | docker login -u $DOCKER_USER --password-stdin
                    docker push $DOCKER_IMAGE
                    '''
                }
            }
        }
    }

    post {
        always {
            // Remove the MySQL container after the pipeline
            sh 'docker rm -f $DB_CONTAINER || true'
        }
        success {
            echo '✅ Pipeline Jenkins terminé avec succès'
        }
        failure {
            echo '❌ Pipeline Jenkins échoué'
        }
    }
}

