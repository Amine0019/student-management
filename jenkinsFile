pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: 'refs/heads/aminebrrn']],
                    userRemoteConfigs: [[
                        url: 'https://github.com/Amine0019/student-management.git',
                        credentialsId: 'github-credentials'
                    ]]
                ])
            }
        }

        stage('Build JAR') {
            steps {
                sh 'mvn clean package -DskipTests'
            }
        }

        stage('Build Docker Image') {
            steps {
                sh "docker build -t aminebrrn/student-management:latest ."
            }
        }

        stage('Push Docker Image') {
            steps {
                sh "echo $DOCKERHUB_CREDENTIALS_PSW | docker login -u $DOCKERHUB_CREDENTIALS_USR --password-stdin"
                sh "docker push aminebrrn/student-management:latest"
            }
        }

        stage('Deploy') {
            steps {
                sh "docker stop studentapp || true"
                sh "docker rm studentapp || true"
                sh "docker run -d --name studentapp -p 8080:8080 aminebrrn/student-management:latest"
            }
        }
    }
}

