
pipeline {
    agent any

    environment {
        DOCKER_IMAGE = "student-management"
        MYSQL_CONTAINER_NAME = "mysql-student-92"
        MYSQL_ROOT_PASSWORD = "root"
        MYSQL_DATABASE = "studentdb"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout([$class: 'GitSCM', branches: [[name: '*/ilyes-mh']],
                          userRemoteConfigs: [[url: 'https://github.com/Amine0019/student-management.git', credentialsId: 'github-credentials']]])
            }
        }

        stage('Start MySQL (Docker)') {
            steps {
                script {
                    // Supprimer l'ancien conteneur s'il existe
                    sh '''
                    if [ $(docker ps -a -q -f name=$MYSQL_CONTAINER_NAME) ]; then
                        docker rm -f $MYSQL_CONTAINER_NAME
                    fi
                    '''

                    // Trouver un port libre
                    HOST_PORT=3306
                    while lsof -i:$HOST_PORT >/dev/null 2>&1; do
                        HOST_PORT=$((HOST_PORT+1))
                    done

                    echo "Using MySQL host port: $HOST_PORT"

                    // Lancer le conteneur MySQL
                    sh """
                    docker pull mysql:8
                    docker run -d --name $MYSQL_CONTAINER_NAME -e MYSQL_ROOT_PASSWORD=$MYSQL_ROOT_PASSWORD -e MYSQL_DATABASE=$MYSQL_DATABASE -p $HOST_PORT:3306 mysql:8
                    """
                    
                    // Stocker le port pour les étapes suivantes
                    env.MYSQL_HOST_PORT = HOST_PORT
                }
            }
        }

        stage('Wait for MySQL') {
            steps {
                script {
                    echo "Waiting for MySQL to be ready..."
                    sh """
                    until docker exec $MYSQL_CONTAINER_NAME mysqladmin ping -h"127.0.0.1" --silent; do
                        sleep 2
                    done
                    """
                }
            }
        }

        stage('Build & Test') {
            steps {
                script {
                    echo "Running tests..."
                    sh './mvnw clean test'
                }
            }
        }

        stage('Build JAR') {
            steps {
                script {
                    echo "Building JAR..."
                    sh './mvnw clean package -DskipTests'
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    echo "Building Docker image..."
                    sh """
                    docker build -t $DOCKER_IMAGE .
                    """
                }
            }
        }

        stage('Push Docker Image') {
            steps {
                script {
                    echo "Pushing Docker image..."
                    sh "docker push $DOCKER_IMAGE"
                }
            }
        }
    }

    post {
        always {
            script {
                // Nettoyer le conteneur MySQL
                sh "docker rm -f $MYSQL_CONTAINER_NAME || true"
                echo "❌ Pipeline Jenkins terminé"
            }
        }
        success {
            echo "✅ Pipeline Jenkins terminé avec succès"
        }
        failure {
            echo "❌ Pipeline Jenkins échoué"
        }
    }
}
